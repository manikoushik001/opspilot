# ============================================================
# OpsPilot Environment Configuration
# ============================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="OpsPilot"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + pgvector)
# For local dev / testing: postgresql+psycopg://postgres:postgres@localhost:5432/opspilot
# For sqlite in-memory/file test mode: sqlite+aiosqlite:///./test.db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/opspilot"
DATABASE_URL_SYNC="postgresql+psycopg://postgres:postgres@localhost:5432/opspilot"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI / LLM Configuration
# Options for LLM_PROVIDER: "mock", "openai", "gemini", "ollama"
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# RAG & Safety Thresholds
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.65
AI_CONFIDENCE_THRESHOLD=0.75
AI_MAX_TOKENS=1000

# File Storage
STORAGE_BACKEND="local" # "local" or "s3"
LOCAL_STORAGE_DIR="./uploads"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"
